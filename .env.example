# ─── Port config ──────────────────────────────────────────────────
# HOST_PORT:          port on the host machine — what you curl/open in browser.
# API_CONTAINER_PORT: port the app listens on inside the container.
# docker-compose maps "${HOST_PORT}:${API_CONTAINER_PORT}". The two MAY differ
# (e.g. HOST_PORT=9090, API_CONTAINER_PORT=8080 → access via :9090, app listens on 8080).
HOST_PORT=8080

# ─── API config (prefix API_) ─────────────────────────────────────
# These vars are read via envconfig.Process("api", cfg) in internal/api/config.go
# so the wire-level env var name is API_<TAG>.

API_CONTAINER_PORT=8080

# API_APP_ENV: dev = console pretty log, prod = JSON 1-line
API_APP_ENV=dev

# API_LOG_LEVEL: debug | info | warn | error
API_LOG_LEVEL=info

# API_SWAGGER_ENABLED: serve /swagger/index.html — set false in production
API_SWAGGER_ENABLED=true

# ─── Service config (no prefix) ───────────────────────────────────
SERVICE_NAME=bookmark_service

# INSTANCE_ID: leave empty to auto-generate UUID at startup
INSTANCE_ID=

# APP_HOSTNAME: định danh instance khi deploy nhiều VM (xuất hiện trong /health-check).
# Leave empty → main.go fallback về os.Hostname() (tên máy host hoặc container ID).
APP_HOSTNAME=

# ─── Redis config (no prefix) ─────────────────────────────────────
# NOTE: docker-compose.yml overrides REDIS_ADDR to "redis:6379" (compose service-name).
# The value below applies only when running the app container standalone (not via compose).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
